<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.copybot.ui.PluginsController">
   <top>
      <VBox spacing="6.0">
         <padding><Insets bottom="6.0" left="10.0" right="10.0" top="10.0" /></padding>
         <children>
            <VBox fx:id="warningsBox" spacing="2.0" />
            <HBox spacing="0.0">
               <children>
                  <ToggleButton fx:id="allFilter" mnemonicParsing="false" selected="true" text="%plugins.filter.ALL" />
                  <ToggleButton fx:id="installedFilter" mnemonicParsing="false" text="%plugins.filter.INSTALLED" />
                  <ToggleButton fx:id="availableFilter" mnemonicParsing="false" text="%plugins.filter.AVAILABLE" />
               </children>
            </HBox>
            <Label fx:id="officialStatus" wrapText="true" style="-fx-text-fill: #616161;" />
         </children>
      </VBox>
   </top>
   <center>
      <!-- one card per plugin, built by PluginsController.render -->
      <ScrollPane fitToWidth="true">
         <content>
            <VBox spacing="8.0">
               <padding><Insets bottom="10.0" left="10.0" right="10.0" top="4.0" /></padding>
               <children>
                  <VBox fx:id="cardsBox" spacing="8.0" />
                  <TitledPane fx:id="embeddedPane" animated="false" expanded="false">
                     <content>
                        <VBox fx:id="embeddedBox" spacing="4.0" />
                     </content>
                  </TitledPane>
                  <TitledPane animated="false" expanded="false" text="%plugins.card.details">
                     <content>
                        <GridPane fx:id="technicalGrid" hgap="10.0" vgap="2.0">
                           <columnConstraints>
                              <ColumnConstraints />
                              <ColumnConstraints hgrow="ALWAYS" />
                           </columnConstraints>
                        </GridPane>
                     </content>
                  </TitledPane>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <VBox spacing="6.0">
         <padding><Insets bottom="10.0" left="10.0" right="10.0" top="8.0" /></padding>
         <children>
            <HBox fx:id="applyBar" alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label fx:id="pendingLabel" wrapText="true" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="applyReason" wrapText="true" style="-fx-text-fill: #616161;" />
                  <Button fx:id="applyButton" mnemonicParsing="false" onAction="#onApplyClick" text="%plugins.apply" />
               </children>
            </HBox>
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Label fx:id="copiedLabel" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#onCopyReportClick" text="%plugins.copy-report" />
                  <Button fx:id="closeButton" cancelButton="true" onAction="#onCloseClick" text="%plugins.close" />
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
