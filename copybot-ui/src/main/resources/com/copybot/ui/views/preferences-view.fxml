<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="520.0" spacing="10.0" xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.copybot.ui.PreferencesController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="%pref.language" />
            <ComboBox fx:id="languageCombo" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="%pref.resources-layout" />
            <ComboBox fx:id="resourcesLayoutCombo" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <Separator />
      <Label style="-fx-font-weight: bold;" text="%update.section" />
      <CheckBox fx:id="updateAutoCheck" mnemonicParsing="false" text="%update.auto" />
      <CheckBox fx:id="updateBeta" mnemonicParsing="false" text="%update.beta" />
      <Label style="-fx-text-fill: #616161;" text="%update.beta.help" wrapText="true">
         <padding>
            <Insets left="24.0" />
         </padding>
      </Label>
      <Label fx:id="updateUnavailable" managed="false" style="-fx-text-fill: #616161;" visible="false" wrapText="true" />
      <Button mnemonicParsing="false" onAction="#onUpdatesClick" text="%menu.edit.updates" />
      <Separator />
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Button cancelButton="true" onAction="#onCancelClick" text="%pref.cancel" />
            <Button defaultButton="true" onAction="#onOkClick" text="%pref.ok" />
         </children>
      </HBox>
   </children>
</VBox>
