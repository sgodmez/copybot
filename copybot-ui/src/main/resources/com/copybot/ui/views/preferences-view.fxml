<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="520.0" spacing="10.0" xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.copybot.ui.PreferencesController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="%pref.language" />
            <ComboBox fx:id="languageCombo" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <VBox spacing="4.0">
         <children>
            <Label text="%pref.plugin-path" />
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <TextField fx:id="pluginPathField" editable="false" HBox.hgrow="ALWAYS" />
                  <Button fx:id="browsePluginPathButton" onAction="#onBrowsePluginPathClick" text="%pref.plugin-path.browse" />
                  <Button fx:id="defaultPluginPathButton" onAction="#onDefaultPluginPathClick" text="%pref.plugin-path.default" />
               </children>
            </HBox>
            <Label fx:id="pluginPathResolved" style="-fx-text-fill: #666666;" />
         </children>
      </VBox>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="%pref.resources-layout" />
            <ComboBox fx:id="resourcesLayoutCombo" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Button cancelButton="true" onAction="#onCancelClick" text="%pref.cancel" />
            <Button fx:id="okButton" defaultButton="true" onAction="#onOkClick" text="%pref.ok" />
         </children>
      </HBox>
   </children>
</VBox>
