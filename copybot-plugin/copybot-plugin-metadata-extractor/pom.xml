<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.copybot</groupId>
        <artifactId>copybot-plugin</artifactId>
        <version>0.7.1-SNAPSHOT</version>
    </parent>

    <artifactId>copybot-plugin-metadata-extractor</artifactId>
    <!-- its own version, not the application's: raised when the plugin changes (see the README, Making a release) -->
    <version>1.0.1</version>

    <properties>
        <!-- IPlugin.getPluginCode(): the folder of the release archive -->
        <plugin.code>metadata-extractor</plugin.code>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>2.21.0</version>
        </dependency>
        <dependency>
            <!-- lossless EXIF rewrite of a JPEG (write-date) -->
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-imaging</artifactId>
            <version>1.0.0-alpha6</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- the end-to-end tests of write-date: copied with the engine's file.write, then run through the engine -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>--add-exports</arg>
                                <arg>com.copybot.engine/com.copybot.plugin.embedded.actions=com.copybot.plugin.metadataextractor</arg>
                                <arg>--add-exports</arg>
                                <arg>com.copybot.engine/com.copybot.engine=com.copybot.plugin.metadataextractor</arg>
                                <arg>--add-exports</arg>
                                <arg>com.copybot.engine/com.copybot.engine.pipeline=com.copybot.plugin.metadataextractor</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-exports com.copybot.engine/com.copybot.plugin.embedded.actions=com.copybot.plugin.metadataextractor --add-exports com.copybot.engine/com.copybot.engine=com.copybot.plugin.metadataextractor --add-exports com.copybot.engine/com.copybot.engine.pipeline=com.copybot.plugin.metadataextractor --enable-native-access=com.copybot.engine</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!--
                    target/copybot-plugin-metadata-extractor-<version>.zip, configured in copybot-plugin/pom.xml. Last:
                    at the package phase it must run after the copy of the libraries (plugins run in the order declared).
                -->
                <artifactId>maven-assembly-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>