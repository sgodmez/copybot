<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.copybot</groupId>
        <artifactId>copybot-plugin</artifactId>
        <version>0.8.0-beta.2</version>
    </parent>

    <artifactId>copybot-plugin-exec</artifactId>
    <!--
        its own version, not the application's: raised when the plugin changes (see the README, Making a release);
        in copybot-plugin/pom.xml, where the plugins that need exec read it too
    -->
    <version>2.0.0</version>

    <properties>
        <!-- IPlugin.getPluginCode(): the folder of the release archive -->
        <plugin.code>exec</plugin.code>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- java.logging: the tests read the log of the runs -->
                            <compilerArgs>
                                <arg>--add-reads</arg>
                                <arg>com.copybot.plugin.exec=java.logging</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-reads com.copybot.plugin.exec=java.logging</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!--
                    target/copybot-plugin-exec-<version>.zip, configured in copybot-plugin/pom.xml. Last: at the
                    package phase it must run after the copy of the libraries (plugins run in the order declared).
                -->
                <artifactId>maven-assembly-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
