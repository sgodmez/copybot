<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.copybot</groupId>
        <artifactId>copybot-plugin</artifactId>
        <version>0.7.1-SNAPSHOT</version>
    </parent>

    <artifactId>copybot-plugin-notify-webhook</artifactId>
    <!-- its own version, not the application's: raised when the plugin changes (see the README, Making a release) -->
    <version>1.0.0</version>

    <properties>
        <!-- IPlugin.getPluginCode(): the folder of the release archive -->
        <plugin.code>notify-webhook</plugin.code>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- jdk.httpserver: the local server of the tests -->
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>com.copybot.plugin.notifywebhook=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-modules jdk.httpserver --add-reads com.copybot.plugin.notifywebhook=jdk.httpserver</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!--
                    target/copybot-plugin-notify-webhook-<version>.zip, configured in copybot-plugin/pom.xml. Last: at
                    the package phase it must run after the copy of the libraries (plugins run in the order declared).
                -->
                <artifactId>maven-assembly-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
